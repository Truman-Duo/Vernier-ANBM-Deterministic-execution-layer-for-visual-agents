{
  "id": "pypi",
  "name": "PyPI",
  "version": "1.0.0",
  "last_verified": "2026-05-17",
  "verified_selectors": ["package-snippet", "package-snippet__title", "package-snippet__description", "button-group--pagination"],
  "unverified_selectors": ["#description", ".package-header__name", ".sidebar-section", "no-results"],
  "unverified_note": "详情页 .sidebar-section__body 已移除，2026-05-17 已改用 section 整体文本提取。列表页全部选择器已验证。",
  "test_url": "https://pypi.org/search/?q=requests",
  "url_patterns": [
    "https://pypi.org/search/*",
    "https://pypi.org/project/*"
  ],
  "output_schema": {
    "project_list": {
      "projects": "array",
      "total_results": "integer",
      "query": "string"
    },
    "project_detail": {
      "name": "string",
      "version": "string",
      "summary": "string",
      "github_url": "string",
      "license": "string",
      "requires_python": "string"
    }
  },
  "states": {
    "project_list": {
      "check": {
        "type": "url_contains",
        "value": "/search/",
        "fallback_description": "PyPI 搜索页 URL 固定包含 /search/"
      },
      "also_check": {
        "type": "element_present",
        "selector": ".package-snippet",
        "fallback_description": "搜索结果条目，2026-05 版 PyPI 使用 .package-snippet 作为条目容器"
      },
      "allowed_actions": ["filter_version", "open_project", "paginate"]
    },
    "project_detail": {
      "check": {
        "type": "element_present",
        "selector": "#description",
        "fallback_description": "包描述区域，PyPI 详情页专属元素（⚠️ 2026-05-17 未经快照验证）"
      },
      "also_check": {
        "type": "element_absent",
        "selector": ".package-snippet"
      },
      "allowed_actions": ["extract_content"]
    },
    "not_found": {
      "check": {
        "type": "element_absent",
        "selector": ".package-snippet",
        "fallback_description": "无搜索结果时 .package-snippet 不存在，且无 #description 表明非详情页"
      },
      "allowed_actions": ["filter_version"]
    }
  },
  "transitions": {
    "project_list": {
      "filter_version": "project_list",
      "open_project": "project_detail",
      "paginate": "project_list"
    },
    "project_detail": {
      "extract_content": "project_detail"
    },
    "not_found": {
      "filter_version": "project_list"
    }
  },
  "action_idempotency": {
    "filter_version": true,
    "open_project": true,
    "paginate": true,
    "extract_content": true
  }
}
