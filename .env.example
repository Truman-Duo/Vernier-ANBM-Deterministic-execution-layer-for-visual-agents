# ANBM 环境变量配置

# ===========================
# Anthropic API（视觉兜底功能必填）
# ===========================
ANTHROPIC_API_KEY=

# ===========================
# Retry 参数（可选，不填使用默认值）
# ===========================
ANBM_RETRY_EXTRACT_MAX=3
ANBM_RETRY_EXTRACT_DELAY=1000
ANBM_RETRY_NAVIGATE_MAX=2
ANBM_RETRY_NAVIGATE_DELAY=2000
ANBM_RETRY_ACT_MAX=2
ANBM_RETRY_ACT_DELAY=1500

# ===========================
# 日志格式（可选，text 或 json）
# ===========================
ANBM_LOG_FORMAT=text

# ===========================
# 浏览器设置（可选）
# ===========================
ANBM_MAX_IDLE_SECONDS=1800

# ===========================
# 健康监控（可选，默认关闭）
# ===========================
ANBM_MONITOR_ENABLED=false      # 设为 true 启动后台定时巡检
ANBM_MONITOR_INTERVAL=3600      # 巡检间隔（秒），默认 1 小时

# ===========================
# 告警输出（至少一种，默认只开日志）
# ===========================
ANBM_ALERT_LOG=true
ANBM_ALERT_WEBHOOK=             # Slack/钉钉 webhook URL，留空则不发送
ANBM_ALERT_FILE=                # 告警 JSONL 文件路径，留空则不写文件

# ===========================
# Session 持久化（可选，默认 memory）
# ===========================
ANBM_SESSION_BACKEND=memory     # memory 或 sqlite
ANBM_SESSION_DB_PATH=sessions.db # SQLite 文件路径（仅 sqlite 后端使用）

# ===========================
# Adapter 热重载（可选，默认开启）
# ===========================
ANBM_HOT_RELOAD=true
