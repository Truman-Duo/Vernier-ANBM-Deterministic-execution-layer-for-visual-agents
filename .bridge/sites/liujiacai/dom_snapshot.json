                          "tag": "a",
                          "role": "",
                          "text": "So, Will This Rewrite Work?",
                          "attrs": {
                            "href": "#headline-5"
                          }
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "role": "",
                      "text": "",
                      "attrs": {},
                      "children": [
