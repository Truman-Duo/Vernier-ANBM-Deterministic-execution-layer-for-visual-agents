                              "text": "https://lobste.rs/s/lapqbz/bun_s_rust_rewrite_has_been_merged",
                              "attrs": {
                                "href": "https://lobste.rs/s/lapqbz/bun_s_rust_rewrite_has_been_merged"
                              }
                            }
                          ]
                        },
                        {
                          "tag": "li",
                          "role": "",
                          "text": "",
                          "attrs": {},
                          "children": [
                            {
                              "tag": "a",
                              "role": "",
                              "text": "https://news.ycombinator.com/item?id=48132488",
                              "attrs": {
                                "href": "https://news.ycombinator.com/item?id=48132488"
                              }
                            }
                          ]
                        },
                        {
                          "tag": "li",
                          "role": "",
                          "text": "",
                          "attrs": {},
                          "children": [
                            {
                              "tag": "a",
                              "role": "",
